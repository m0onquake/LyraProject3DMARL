# This repository is an overlay for an existing Unreal Engine 5.3 Lyra project.
# Keep the locally installed Lyra baseline on disk, but track only MARL changes.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LyraProject.uproject

!/Docs/
!/Docs/**

!/Config/
/Config/*
!/Config/DefaultEngine.ini

!/Content/
/Content/*
!/Content/MARL/
!/Content/MARL/**

!/Plugins/
/Plugins/*
!/Plugins/TacticalMARL/
!/Plugins/TacticalMARL/**

!/Source/
/Source/*
!/Source/LyraGame/
/Source/LyraGame/*
!/Source/LyraGame/LyraGame.Build.cs

!/Source/LyraGame/AI/
/Source/LyraGame/AI/*
!/Source/LyraGame/AI/TacticalRedBotSpawnPoint.cpp
!/Source/LyraGame/AI/TacticalRedBotSpawnPoint.h
!/Source/LyraGame/AI/TacticalRedBotStateComponent.cpp
!/Source/LyraGame/AI/TacticalRedBotStateComponent.h

!/Source/LyraGame/GameModes/
/Source/LyraGame/GameModes/*
!/Source/LyraGame/GameModes/LyraBotCreationComponent.cpp
!/Source/LyraGame/GameModes/LyraBotCreationComponent.h

!/Source/LyraGame/Weapons/
/Source/LyraGame/Weapons/*
!/Source/LyraGame/Weapons/TacticalWeaponInstances.cpp
!/Source/LyraGame/Weapons/TacticalWeaponInstances.h

# Generated and local-only data inside tracked overlay directories.
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/*.log
**/runs/
**/checkpoints/
